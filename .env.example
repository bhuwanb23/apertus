# ============================================================================
# "Swiss Reality Check" - configuration TEMPLATE. Contains no secrets.
#
#   Copy to .env and edit.        cp .env.example .env
#   NEVER commit .env.            It is gitignored.
#
# The harness reads this file (via python-dotenv) from eval/.env. If you are
# running from the repo root, put a copy at eval/.env instead:
#
#   cp .env.example eval/.env
#
# eval/config.py is the authoritative list of supported variables; the keys
# below are every one of them. An unset model backend is NOT silently ignored:
# config.py resolves it to `mock`, stamps is_mock=true on every artefact it
# touches, and prints a banner. A missing model must be visible.
#
# THE SERVED MODEL
# The 8B endpoint below is a Q4_K_M quantisation of swiss-ai/Apertus-v1.5-8B
# (text-only extract) served locally by llama.cpp over an OpenAI-compatible
# HTTP interface. Start it first:
#
#   llama-server -m models/Apertus-v1.5-8B-Q4_K_M.gguf \
#       --host 127.0.0.1 --port 8080 --ctx-size 8192 -ngl 99 --jinja
#
# Quantisation, the llama.cpp fork and the text-only extract are all DISCLOSED
# SUBSTITUTIONS and are recorded in DATASHEET.md.
# ============================================================================

# ---- 8B ---------------------------------------------------------------------
# BACKEND   http | openai | mock
#             http  - stdlib urllib, any OpenAI-compatible server (llama.cpp,
#                    vLLM). What this project used. Zero dependencies.
#             openai- official OpenAI SDK (needs the `openai` package).
#             mock  - deterministic offline stand-in. NEVER a publishable
#                     number. Only for testing the harness itself.
# API_BASE  must include the /v1 suffix.
# MODEL_ID  recorded in every artefact for provenance. llama-server ignores it
#           on single-model servers, but it is not optional bookkeeping.
# API_KEY   a local server ignores it; the OpenAI-compatible convention for
#           "none needed" is the literal string EMPTY.
APERTUS_8B_BACKEND=http
APERTUS_8B_API_BASE=http://127.0.0.1:8080/v1
APERTUS_8B_MODEL_ID=apertus-v1.5-8b-text-q4_k_m
APERTUS_8B_API_KEY=EMPTY
APERTUS_8B_MAX_TOKENS=2048
APERTUS_8B_TIMEOUT=180

# ---- 70B --------------------------------------------------------------------
# MOCK BACKEND IN THIS WORK. NOT USED FOR ANY REPORTED RESULT.
#
# Apertus-v1.5-70B is ~70 B parameters: it cannot be loaded on the 8 GB card
# used here at any usable quantisation, and no hosted endpoint was arranged.
# The two 70B numbers that the Phase 4 plan originally called for therefore do
# not exist. Every 70B run in this repository resolves to the `mock` backend,
# is stamped is_mock=true, and prints a loud banner. That is deliberate: a
# missing 70B has to be visible rather than quietly absent.
#
# Leave these commented out to keep that behaviour. Do NOT set
# APERTUS_70B_BACKEND=mock to silence an error - a mock 70B number reaching a
# chart is precisely the failure this guards against.
#
# When a real route exists, uncomment and fill in:
#   hosted OpenAI-compatible endpoint -> BACKEND=openai, API_KEY=<key>
#   local vLLM on a larger machine   -> BACKEND=http,   API_KEY=EMPTY
# APERTUS_70B_BACKEND=
# APERTUS_70B_API_BASE=
# APERTUS_70B_API_KEY=
# APERTUS_70B_MODEL_ID=
# APERTUS_70B_MAX_TOKENS=2048
# APERTUS_70B_TIMEOUT=180

# ---- retry and rate-limit knobs ----------------------------------------------
# A local server that OOMs mid-run would otherwise abort the whole arm, so the
# client retries with a linear back-off and paces its requests.
EVAL_RETRY_ATTEMPTS=3
EVAL_RETRY_DELAY=5
EVAL_REQUEST_DELAY=0.2

# ---- prompt variant (optional, advanced) ------------------------------------
# Named variant, not free text - changing it mid-project invalidates comparison
# against earlier runs, so it is stamped into every artefact. Leave unset to
# take the config.py default.
# EVAL_KNOWLEDGE_VARIANT=v1_letter_only