# ---- secrets -----------------------------------------------------------------
# eval/.env holds API keys. It is a template-tracked file (.env.example only).
.env
eval/.env
*.env
!.env.example
!eval/.env.example

# ---- eval run artefacts ------------------------------------------------------
# Raw responses contain full model output and are regenerated by re-running.
# Scores are regenerated too. Keep them out of git and out of any release zip
# until a run is actually final; the Phase 2.4 checklist calls for a 50 MB
# budget, which does not belong in a repository.
eval/results/
results/

# ---- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

