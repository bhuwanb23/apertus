# ---- secrets -----------------------------------------------------------------
# eval/.env holds API keys. It is a template-tracked file (.env.example only).
.env
eval/.env
*.env
!.env.example
!eval/.env.example

# ---- derived Phase 3.3 artefacts ----------------------------------------------
# fix/rag/corpus/corpus.json is rebuilt byte-identically from the tracked
# raw_pages/ files by `python fix/rag/prepare_corpus.py`, so tracking it would
# only add 464 KB of duplication that can go stale.
fix/rag/corpus/

# RAG run outputs. Same reason as eval/results/ above, plus one more: these are
# currently mock-backend self-tests, and a tracked results_*.json is exactly the
# file someone later quotes as a result. The mock numbers live in
# fix/rag/RESULTS.md, labelled as mock, where they cannot be mistaken.
fix/rag/results_rag_*.json

# ---- eval run artefacts ------------------------------------------------------
# By default NOTHING under eval/results/ is tracked: raw model output and
# intermediate stages are regenerated by re-running, they are large, and the
# Phase 2.4 checklist calls for a 50 MB budget, which does not belong in a
# repository.
#
# Four subtrees ARE tracked, because they are the evidence behind every number
# in the submission and a reader who cannot see them has nothing to check the
# claims against (~657 KB total, which is fine for git):
#
#   final_scores/  test_scores.json + statistical_report.md  (the numbers)
#   charts/        4 SVG figures + README.md                 (the figures)
#   narrative/     findings.md                               (the writeup)
#   test_run/      per-item rows: is_correct, parse_reason, raw_response
#
# Note the pattern is `eval/results/*` and not `eval/results/`. A trailing
# slash excludes the directory itself, and git cannot re-include anything
# beneath an excluded directory - so that form silently ignores the four
# evidence directories no matter what the `!` lines below say. `*` leaves the
# parent un-excluded, so the negations take effect.
eval/results/*
!eval/results/final_scores/
!eval/results/charts/
!eval/results/narrative/
!eval/results/test_run/

# Derived and per-request artefacts: full model output, intermediate parse and
# score stages, and the run log stream. Regenerated by re-running; enormous.
eval/results/raw_responses/
eval/results/logs/
eval/results/parsed/
eval/results/scores/

# Dense-retrieval vector caches. Regenerated from the corpus; multi-MB binaries.
fix/rag/**/*.npz
*.npz

# A stray `results/` at the repo root (from a run invoked from the wrong cwd).
# ANCHORED with a leading slash on purpose. The unanchored form `results/`
# matched eval/results/ at every depth and, being on line 58, beat the four
# `!` negations above - so the evidence directories stayed ignored no matter
# what they said. Last-match-wins is the whole rule here.
/results/

