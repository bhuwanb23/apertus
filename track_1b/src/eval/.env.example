# ============================================================================
# "Swiss Reality Check" - Phase 2 configuration
# Copy to eval/.env and fill in. NEVER commit eval/.env - it is gitignored.
# ============================================================================

# ----------------------------------------------------------------------------
# 8B - local, 4-bit, served by llama.cpp on your own GPU
# ----------------------------------------------------------------------------
# An 8 GB card (RTX 5060) cannot hold Apertus-8B in bf16 (~16 GB). Use a Q4_K_M
# GGUF build. Start the server with:
#
#   ./llama-server -m Apertus-8B-Instruct-Q4_K_M.gguf \
#       --host 127.0.0.1 --port 8080 --ctx-size 8192 -ngl 99
#
# Then set:
APERTUS_8B_BACKEND=http
APERTUS_8B_API_BASE=http://127.0.0.1:8080/v1
APERTUS_8B_MODEL_ID=Apertus-8B-Instruct-Q4_K_M
APERTUS_8B_API_KEY=EMPTY
APERTUS_8B_MAX_TOKENS=512
# Large-context MCQ prompts are short, but values scenarios are not.
APERTUS_8B_TIMEOUT=180

# ----------------------------------------------------------------------------
# 70B - not yet arranged. Leave unset and the harness falls back to mock.
# When you have a route, set one of:
#   hosted OpenAI-compatible endpoint  -> BACKEND=openai, API_KEY=<key>
#   local vLLM on a bigger machine     -> BACKEND=http,   API_KEY=EMPTY
# ----------------------------------------------------------------------------
# APERTUS_70B_BACKEND=openai
# APERTUS_70B_API_BASE=https://<endpoint>/v1
# APERTUS_70B_API_KEY=sk-...
# APERTUS_70B_MODEL_ID=swiss-ai/Apertus-v1.5-70B-Instruct

# ----------------------------------------------------------------------------
# To self-test the harness with no model at all, force the mock backend:
# ----------------------------------------------------------------------------
# APERTUS_8B_BACKEND=mock
# APERTUS_70B_BACKEND=mock